@app.route('/paiement/initier', methods=['POST'])
def initier_paiement():
    artisan_id = request.form.get('artisan_id', type=int)
    plan_id = request.form.get('plan_id', type=int)
    moyen = request.form.get('moyen_paiement', 'orange_money')
    prix = {1:50000, 2:120000, 3:200000}.get(plan_id, 0)
    if not artisan_id or prix==0:
        flash('❌ Plan invalide', 'error')
        return redirect(url_for('index'))
    ref = f"FIXPRO-{artisan_id}-{int(time.time())}"
    conn = get_db()
    conn.execute(
        'INSERT INTO transactions (artisan_id, montant, type, reference, statut) VALUES (?,?,?,?,?)',
        (artisan_id, prix, f'premium_{plan_id}', ref, 'en_attente')
    )
    conn.commit()
    conn.close()
    flash(f'💳 Demande de {prix:,} GNF initiée (réf: {ref})', 'info')
    # Simulation de paiement réussi (appel webhook simulé)
    # On simule un succès après 2 secondes (normalement c'est le fournisseur qui appelle)
    # Pour démonstration, on active le premium directement (à désactiver en production)
    # Ici on active pour l'exemple
    conn = get_db()
    conn.execute('UPDATE transactions SET statut="reussi" WHERE reference=?', (ref,))
    jours = {1:30, 2:90, 3:180}.get(plan_id, 30)
    conn.execute('UPDATE artisans SET premium=1, premium_until=? WHERE id=?',
                 ((datetime.now()+timedelta(days=jours)).isoformat(), artisan_id))
    conn.commit()
    conn.close()
    flash('🎉 Paiement confirmé ! L\'artisan est maintenant en PREMIUM.', 'success')
    return redirect(url_for('confirmation_paiement', reference=ref))

@app.route('/paiement/confirmation/<reference>')
def confirmation_paiement(reference):
    conn = get_db()
    t = conn.execute('SELECT * FROM transactions WHERE reference=?', (reference,)).fetchone()
    conn.close()
    if not t:
        flash('❌ Transaction inconnue', 'error')
        return redirect(url_for('index'))
    return render_template('confirmation.html', transaction=t)

# ========== WEBHOOK (pour paiement réel) ==========
@app.route('/paiement/webhook', methods=['POST'])
def webhook():
    data = request.get_json() or {}
    ref = data.get('reference')
    statut = data.get('statut', 'success')
    if ref and statut == 'success':
        conn = get_db()
        t = conn.execute('SELECT artisan_id FROM transactions WHERE reference=?', (ref,)).fetchone()
        if t:
            conn.execute('UPDATE transactions SET statut="reussi" WHERE reference=?', (ref,))
            # Déterminer la durée selon le type (simplifié)
            conn.execute('UPDATE artisans SET premium=1, premium_until=? WHERE id=?',
                         ((datetime.now()+timedelta(days=30)).isoformat(), t['artisan_id']))
            conn.commit()
        conn.close()
        return jsonify({'status':'ok'})
    return jsonify({'status':'failed'}), 400

