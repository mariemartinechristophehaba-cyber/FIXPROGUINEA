<html>
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chat avec {{artisan.nom}}</title>
<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<style>
body{font-family:'Segoe UI',sans-serif;background:#f0f4f8;padding:20px;max-width:800px;margin:0 auto}
.container{background:#fff;border-radius:16px;padding:30px;box-shadow:0 10px 30px rgba(0,0,0,.08)}
#messages{height:400px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:8px;padding:10px;margin:15px 0;background:#f7fafc}
.message{margin:8px 0;padding:8px 12px;border-radius:8px;background:#e2e8f0}
.message.moi{background:#bee3f8;text-align:right}
.message .nom{font-weight:600;font-size:14px}
.message .heure{font-size:12px;color:#718096;margin-left:10px}
#form-chat{display:flex;gap:10px}
#form-chat input[type="text"]{flex:1;padding:10px;border:2px solid #e2e8f0;border-radius:8px;font-size:15px}
#form-chat button{background:#4299e1;color:#fff;border:none;padding:10px 20px;border-radius:8px;font-weight:600;cursor:pointer}
#form-chat button:hover{background:#3182ce}
.back-link{display:inline-block;margin-top:15px;color:#4299e1;text-decoration:none}
.status{color:#718096;font-style:italic;text-align:center}
</style>
</head>
<body>
<div class="container">
    <h2>💬 Chat avec {{artisan.nom}}</h2>
    <div id="messages">
        <div class="status">Connexion en cours...</div>
    </div>
    <form id="form-chat">
        <input type="text" id="input-message" placeholder="Votre message..." autocomplete="off">
        <button type="submit">Envoyer</button>
    </form>
    <a href="/" class="back-link">← Retour à l'accueil</a>
</div>
<script>
    var socket = io();
    var room = "{{room}}";
    var nom = "{{client_nom}}";
    var artisan_id = {{artisan.id}};

    socket.on('connect', function() {
        socket.emit('join', {room: room, nom: nom});
        document.querySelector('.status').textContent = 'Connecté';
    });

    socket.on('status', function(data) {
        var div = document.createElement('div');
        div.className = 'status';
        div.textContent = data.msg;
        document.getElementById('messages').appendChild(div);
        document.getElementById('messages').scrollTop = document.getElementById('messages').scrollHeight;
    });

    socket.on('new_message', function(data) {
        var div = document.createElement('div');
        div.className = 'message';
        if (data.nom === nom) div.classList.add('moi');
        div.innerHTML = '<span class="nom">' + data.nom + '</span><span class="heure">' + data.time + '</span><br>' + data.message;
        document.getElementById('messages').appendChild(div);
        document.getElementById('messages').scrollTop = document.getElementById('messages').scrollHeight;
    });

    document.getElementById('form-chat').onsubmit = function(e) {
        e.preventDefault();
        var input = document.getElementById('input-message');
        var msg = input.value.trim();
        if (msg) {
            socket.emit('send_message', {room: room, nom: nom, message: msg, artisan_id: artisan_id});
            input.value = '';
        }
    };

    window.onbeforeunload = function() {
        socket.emit('leave', {room: room, nom: nom});
    };
</script>
</body>
</html>''')

