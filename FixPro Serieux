                    <tr class="{% if a.est_premium %}premium-row{% endif %}" data-lat="{{a.latitude}}" data-lng="{{a.longitude}}" data-nom="{{a.nom}}">
                        <td>
                            <a href="/artisan/{{a.id}}" style="color:#2d3748;text-decoration:none;font-weight:500">{{a.nom}}</a>
                            {% if a.est_premium %}<span class="badge-premium">⭐ PREMIUM</span>{% endif %}
