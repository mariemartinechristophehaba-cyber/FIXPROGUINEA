                                        {% if a.disponible %}⏳{% else %}✅{% endif %}
                                    </button>
                                </form>
                                {% if not a.est_premium %}
                                    <a href="/paiement/{{a.id}}" class="btn btn-gold btn-small">⭐ Mettre en avant</a>
