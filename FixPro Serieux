DB_PATH = Path(_file_).parent / "fixpro.db"

# ========== BASE DE DONNÉES ==========
def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db()
    # Artisans (avec coordonnées GPS)
    conn.execute('''CREATE TABLE IF NOT EXISTS artisans (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nom TEXT NOT NULL,
        telephone TEXT NOT NULL,
        ville TEXT NOT NULL,
        disponible INTEGER DEFAULT 1,
        premium INTEGER DEFAULT 0,
        premium_until TEXT,
        nb_vues INTEGER DEFAULT 0,
        date_inscription TEXT DEFAULT CURRENT_TIMESTAMP,
        latitude REAL,
        longitude REAL
    )''')
    # Compétences (métiers)
    conn.execute('''CREATE TABLE IF NOT EXISTS competences (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nom TEXT UNIQUE NOT NULL
    )''')
    # Relation artisan-compétences
    conn.execute('''CREATE TABLE IF NOT EXISTS artisan_competences (
        artisan_id INTEGER,
        competence_id INTEGER,
        FOREIGN KEY(artisan_id) REFERENCES artisans(id),
        FOREIGN KEY(competence_id) REFERENCES competences(id),
        PRIMARY KEY(artisan_id, competence_id)
    )''')
    # Messages (chat)
    conn.execute('''CREATE TABLE IF NOT EXISTS messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        expediteur_id INTEGER,      -- 0 pour client anonyme, >0 pour artisan
        expediteur_nom TEXT,
        destinataire_id INTEGER,    -- ID de l'artisan destinataire
        message TEXT NOT NULL,
        lu INTEGER DEFAULT 0,
        date_envoi TEXT DEFAULT CURRENT_TIMESTAMP,
        room TEXT                   -- identifiant de conversation
    )''')
    # Transactions
    conn.execute('''CREATE TABLE IF NOT EXISTS transactions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        artisan_id INTEGER,
        montant REAL,
        type TEXT,
        reference TEXT UNIQUE,
        statut TEXT,
        date_transaction TEXT DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(artisan_id) REFERENCES artisans(id)
    )''')
    # Index
    conn.execute('CREATE INDEX IF NOT EXISTS idx_artisan_ville ON artisans(ville)')
    conn.execute('CREATE INDEX IF NOT EXISTS idx_artisan_premium ON artisans(premium)')

    # Insertion des compétences de base
    competences_base = ['Plombier', 'Électricien', 'Électricienne', 'Frigoriste', 'Maçon', 'Peintre', 'Menuisier', 'Cuisiniste', 'Jardinier']
    for c in competences_base:
        conn.execute('INSERT OR IGNORE INTO competences (nom) VALUES (?)', (c,))

    # Données de démo (artisans avec coordonnées approximatives pour Conakry et N'Zérékoré)
    if not conn.execute('SELECT COUNT(*) FROM artisans').fetchone()[0]:
        now = datetime.now().isoformat()
        artisans_demo = [
            ('Mamadou Diallo', '+224 627 31 60 69', 'Conakry', 1, 1, (datetime.now()+timedelta(days=30)).isoformat(), 9.6412, -13.5784),
            ('Fatoumata Camara', '+224 622 10 44 78', 'N\'Zérékoré', 1, 0, None, 7.7478, -8.8181),
            ('Ibrahima Sow', '+224 655 90 12 33', 'Kankan', 0, 0, None, 10.3846, -9.3068),
            ('Alpha Barry', '+224 600 11 22 33', 'Kindia', 1, 0, None, 10.0557, -12.8557)
        ]
        for a in artisans_demo:
            cur = conn.execute(
                'INSERT INTO artisans (nom, telephone, ville, disponible, premium, premium_until, latitude, longitude) VALUES (?,?,?,?,?,?,?,?)',
                a
            )
            artisan_id = cur.lastrowid
            # Attribuer 2 compétences aléatoires
            comps = conn.execute('SELECT id FROM competences ORDER BY RANDOM() LIMIT 2').fetchall()
            for c in comps:
                conn.execute('INSERT INTO artisan_competences (artisan_id, competence_id) VALUES (?,?)', (artisan_id, c['id']))
    conn.commit()
    conn.close()

# ========== ROUTES ==========
@app.route('/')
def index():
    conn = get_db()
    conn.execute('UPDATE artisans SET nb_vues = nb_vues + 1')
    conn.commit()
    ville_filtre = request.args.get('ville', '')
    competence_filtre = request.args.get('competence', '')
    query = '''SELECT a.*, 
        GROUP_CONCAT(c.nom) as competences,
        CASE WHEN a.premium=1 AND a.premium_until > datetime("now") THEN 1 ELSE 0 END as est_premium,
        julianday(a.premium_until)-julianday("now") as jours_restants
        FROM artisans a
        LEFT JOIN artisan_competences ac ON a.id = ac.artisan_id
        LEFT JOIN competences c ON ac.competence_id = c.id
        WHERE 1=1'''
    params = []
    if ville_filtre:
        query += ' AND a.ville = ?'
        params.append(ville_filtre)
    if competence_filtre:
        query += ' AND c.nom = ?'
        params.append(competence_filtre)
    query += ' GROUP BY a.id ORDER BY est_premium DESC, a.disponible DESC, a.nb_vues DESC'
    artisans = conn.execute(query, params).fetchall()
    # Récupérer toutes les villes et compétences pour les filtres
    villes = [row['ville'] for row in conn.execute('SELECT DISTINCT ville FROM artisans ORDER BY ville').fetchall()]
    competences = [row['nom'] for row in conn.execute('SELECT nom FROM competences ORDER BY nom').fetchall()]
    conn.close()
    return render_template('index.html', artisans=artisans, villes=villes, competences=competences,
                           ville_filtre=ville_filtre, competence_filtre=competence_filtre)

@app.route('/artisan/<int:id>')
def detail(id):
    conn = get_db()
    a = conn.execute('''SELECT a.*, GROUP_CONCAT(c.nom) as competences
        FROM artisans a
        LEFT JOIN artisan_competences ac ON a.id = ac.artisan_id
        LEFT JOIN competences c ON ac.competence_id = c.id
        WHERE a.id = ? GROUP BY a.id''', (id,)).fetchone()
    if not a:
        flash('❌ Artisan introuvable', 'error')
        return redirect(url_for('index'))
    conn.execute('UPDATE artisans SET nb_vues = nb_vues + 1 WHERE id=?', (id,))
    conn.commit()
    conn.close()
    return render_template('detail.html', artisan=a)

@app.route('/ajouter', methods=['POST'])
def ajouter():
    nom = request.form.get('nom', '').strip()
    telephone = request.form.get('telephone', '').strip()
    ville = request.form.get('ville', '')
    disponible = 1 if request.form.get('disponible') == 'on' else 0
    latitude = request.form.get('latitude', type=float)
    longitude = request.form.get('longitude', type=float)
    competences = request.form.getlist('competences')  # liste d'IDs

    if not all([nom, telephone, ville, competences]):
        flash('❌ Tous les champs sont obligatoires (au moins une compétence)', 'error')
        return redirect(url_for('index'))
    if not re.match(r'^\+224\s?\d{2}\s?\d{2}\s?\d{2}\s?\d{2}$', telephone):
        flash('❌ Numéro invalide (+224 62 73 16 06 9)', 'error')
        return redirect(url_for('index'))
    if not latitude or not longitude:
        flash('❌ Veuillez activer la géolocalisation ou saisir vos coordonnées.', 'error')
        return redirect(url_for('index'))

    conn = get_db()
    cur = conn.execute(
        'INSERT INTO artisans (nom, telephone, ville, disponible, latitude, longitude) VALUES (?,?,?,?,?,?)',
        (nom, telephone, ville, disponible, latitude, longitude)
    )
    artisan_id = cur.lastrowid
    # Ajouter les compétences
    for comp_id in competences:
        conn.execute('INSERT INTO artisan_competences (artisan_id, competence_id) VALUES (?,?)', (artisan_id, comp_id))
    conn.commit()
    conn.close()
    flash(f'✅ {nom} ajouté avec succès !', 'success')
    return redirect(url_for('page_paiement', artisan_id=artisan_id))

@app.route('/artisan/<int:id>/toggle', methods=['POST'])
def toggle(id):
    conn = get_db()
    a = conn.execute('SELECT nom, disponible FROM artisans WHERE id=?', (id,)).fetchone()
    if a:
        new = 0 if a['disponible'] else 1
        conn.execute('UPDATE artisans SET disponible=? WHERE id=?', (new, id))
        conn.commit()
        flash(f'🔄 {a["nom"]} maintenant {"disponible" if new else "indisponible"}', 'info')
    conn.close()
    return redirect(url_for('index'))

# ========== CHAT (SOCKETIO) ==========
@app.route('/chat/<int:artisan_id>')
def chat(artisan_id):
    conn = get_db()
    a = conn.execute('SELECT * FROM artisans WHERE id=?', (artisan_id,)).fetchone()
    conn.close()
    if not a:
        flash('❌ Artisan inconnu', 'error')
        return redirect(url_for('index'))
    # Générer un identifiant de room unique pour cette conversation (client anonyme)
    # On utilise la session pour garder un pseudo
    if 'client_nom' not in session:
        session['client_nom'] = f'Client_{secrets.token_hex(4)}'
    room = f"artisan_{artisan_id}client{session['client_nom']}"
    return render_template('chat.html', artisan=a, room=room, client_nom=session['client_nom'])

@socketio.on('join')
def handle_join(data):
    room = data['room']
    join_room(room)
    emit('status', {'msg': f"{data['nom']} a rejoint la conversation"}, room=room)

@socketio.on('send_message')
def handle_message(data):
    room = data['room']
    nom = data['nom']
    message = data['message']
    artisan_id = data['artisan_id']
    # Stocker en base
    conn = get_db()
    conn.execute(
        'INSERT INTO messages (expediteur_nom, destinataire_id, message, room) VALUES (?,?,?,?)',
        (nom, artisan_id, message, room)
    )
    conn.commit()
    conn.close()
    emit('new_message', {'nom': nom, 'message': message, 'time': datetime.now().strftime('%H:%M')}, room=room)

@socketio.on('leave')
def handle_leave(data):
    room = data['room']
    leave_room(room)
    emit('status', {'msg': f"{data['nom']} a quitté"}, room=room)

