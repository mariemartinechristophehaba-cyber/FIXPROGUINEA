# Serveur
PORT=5000
HOST=0.0.0.0

# Configuration CORS (séparer par des virgules)
CORS_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Commission FixPro
FIXPRO_DEFAULT_COMMISSION=10
FIXPRO_COMMISSION_RATE=0.10

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/fixpro.log