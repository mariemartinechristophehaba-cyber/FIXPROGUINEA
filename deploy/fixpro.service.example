[Unit]
Description=FixPro Gunicorn service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/youruser/fixpro
Environment="PATH=/home/youruser/fixpro/.venv/bin"
ExecStart=/home/youruser/fixpro/.venv/bin/gunicorn -w 4 -b 0.0.0.0:8000 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
