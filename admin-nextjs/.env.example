# --- Public (expose au navigateur) ---
# URL du backend Flask, utilisee pour les liens cote client.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# --- Secrets SERVEUR uniquement : ne JAMAIS prefixer avec NEXT_PUBLIC_ ---

# URL du backend Flask utilisee par le proxy serveur (defaut : NEXT_PUBLIC_API_URL).
FLASK_API_URL=http://127.0.0.1:5000

# Cle partagee avec le backend Flask. Doit valoir exactement ADMIN_API_KEY cote Flask.
ADMIN_API_KEY=change_me

# Secret de signature du cookie de session admin.
# Generer : openssl rand -hex 32
ADMIN_SESSION_SECRET=change_me_32_octets_aleatoires_minimum

# Identifiants de connexion au tableau de bord.
ADMIN_DASHBOARD_EMAIL=admin@fixpro.local
ADMIN_DASHBOARD_PASSWORD=change_me
ADMIN_DASHBOARD_UNLOCK=change_me
