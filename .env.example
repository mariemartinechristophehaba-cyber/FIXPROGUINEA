# Mode : development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# Cle secrete des sessions Flask.
# En production, elle doit etre longue et identique sur toutes les instances.
# Commande : python manage.py secret
SECRET_KEY=remplacez_ceci_par_une_cle_generee

# Base de donnees : laisser vide en developpement pour utiliser SQLite local.
# En production (Supabase) : copiez ici l'URL de connexion "Connection string"
# avec mot de passe, de la section Database / PSQL.
DATABASE_URL=

# Informations Supabase (utilisees par l'app mobile et les scripts).
SUPABASE_URL=https://votre-projet-id.supabase.co
SUPABASE_ANON_KEY=votre-anon-key

# Serveur local (developpement)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Commission FixPro sur chaque intervention
FIXPRO_COMMISSION_RATE=0.10

# Google OAuth (optionnel)
# Inscrivez l'application dans Google Cloud Console pour obtenir ces valeurs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/google-signup/callback

# Developpement uniquement : ouvrir toutes les pages sans connexion.
# Role du compte de test : client | artisan
# Ne JAMAIS activer en production.
BYPASS_AUTH=1
DEV_ROLE=client
