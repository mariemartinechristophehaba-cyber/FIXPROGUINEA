# Mode : development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# Cle secrete des sessions Flask.
# En production, elle doit etre longue et identique sur toutes les instances.
# Commande : python manage.py secret
SECRET_KEY=remplacez_ceci_par_une_cle_generee

# Base de donnees : laisser vide en developpement pour utiliser SQLite local.
# En production (Supabase) : OBLIGATOIRE. Copiez l'URL "Connection string" avec
# mot de passe (section Database / PSQL). Sans elle, l'application refuse de
# demarrer en production (le systeme de fichiers Vercel est en lecture seule).
DATABASE_URL=

# Rate limiting : "memory://" ne fonctionne pas en serverless (process
# ephemere). En production, fournissez une URL Redis / Upstash, ex :
# RATELIMIT_STORAGE_URI=redis://default:motdepasse@host:6379
RATELIMIT_STORAGE_URI=

# Informations Supabase (utilisees par l'app mobile et les scripts).
SUPABASE_URL=https://votre-projet-id.supabase.co
SUPABASE_ANON_KEY=votre-anon-key
# Cle service pour le stockage de fichiers (Storage).
SUPABASE_SERVICE_KEY=votre-service-key

# Serveur local (developpement)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Commission FixPro sur chaque intervention
FIXPRO_COMMISSION_RATE=0.10

# Google OAuth (optionnel)
# Inscrivez l'application dans Google Cloud Console pour obtenir ces valeurs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/google-signup/callback

# Google Gemini (optionnel)
# Obtenez une cle gratuite sur aistudio.google.com/app/apikey
# Si vide, l'assistante utilise sa logique basee sur des regles.
GOOGLE_API_KEY=

# Si 1, le matching refuse les techniciens sans position GPS recente.
GPS_REQUIRED=0

# Dashboard admin Next.js
# ADMIN_DASHBOARD_URL = URL de l'admin Next.js en production
# ADMIN_API_KEY = cle partagee forte entre Flask et le dashboard
ADMIN_DASHBOARD_URL=http://localhost:3006
ADMIN_API_KEY=remplacez_par_une_cle_generee

# Verrouillage du dashboard admin Next.js
# En production, utilisez des mots de passes forts et uniques.
ADMIN_DASHBOARD_EMAIL=admin@fixpro.local
ADMIN_DASHBOARD_PASSWORD=remplacez_par_un_mot_de_passe_fort
ADMIN_DASHBOARD_UNLOCK=remplacez_par_un_code_fort
