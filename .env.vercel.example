# Configuration FixPro pour Vercel + Supabase
# Copiez ce fichier et renommez-le en .env.local pour le développement local
# Pour Vercel, ajoutez ces variables dans les Environment Variables du projet

# === CONFIGURATION FLASK ===
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=votre_secret_key_ici_generer_avec_python_secrets

# === CONFIGURATION BASE DE DONNÉES ===
# IMPORTANT: Vercel ne supporte pas SQLite, utilisez OBLIGATOIREMENT Supabase
FIXPRO_DB_ENGINE=supabase
FIXPRO_DB_PATH=fixpro.db

# === CONFIGURATION SUPABASE ===
# Obtenez ces valeurs depuis votre dashboard Supabase: https://supabase.com/dashboard
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_ici
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_ici
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@db.votre-projet.supabase.co:5432/postgres

# === CONFIGURATION SERVEUR ===
PORT=5000
HOST=0.0.0.0

# === CONFIGURATION CORS ===
# Remplacez par votre domaine Vercel déployé
CORS_ORIGINS=https://votre-app.vercel.app,https://votre-app.vercel.app

# === CONFIGURATION COMMISSION ===
FIXPRO_DEFAULT_COMMISSION=10
FIXPRO_COMMISSION_RATE=0.10

# === CONFIGURATION LOGGING ===
LOG_LEVEL=INFO

# === NOTES IMPORTANTES ===
# 1. Générez un SECRET_KEY unique: python -c "import secrets; print(secrets.token_hex(32))"
# 2. Créez un projet Supabase sur https://supabase.com
# 3. Exécutez le schéma schema_supabase.sql dans votre projet Supabase
# 4. Copiez les clés depuis le dashboard Supabase
# 5. N'ajoutez JAMAIS le fichier .env dans Git
